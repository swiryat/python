# ====================================
# Унифицированные окончания строк
# ====================================

# Программные файлы — всегда LF
*.py      text eol=lf
*.sh      text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.csv     text eol=lf
*.tsv     text eol=lf

# Текстовые документы — тоже LF
*.txt     text eol=lf
*.rst     text eol=lf

# Windows скрипты — CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Бинарные файлы — не изменять
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.zip     binary
*.exe     binary
*.dll     binary
